# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

# If JAVA_HOME is set, use it; else use java from PATH
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

MAVEN_WRAPPER_JAR="$(cd "$(dirname "$0")" && pwd)/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$(cd "$(dirname "$0")" && pwd)/.mvn/wrapper/maven-wrapper.properties"

# If the jar doesn't exist, download it first
if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
  DOWNLOAD_URL=$(grep "wrapperUrl" "$MAVEN_WRAPPER_PROPERTIES" | sed 's/wrapperUrl=//')
  echo "Downloading Maven Wrapper from: $DOWNLOAD_URL"
  if command -v wget > /dev/null; then
    wget -q -O "$MAVEN_WRAPPER_JAR" "$DOWNLOAD_URL"
  elif command -v curl > /dev/null; then
    curl -sL -o "$MAVEN_WRAPPER_JAR" "$DOWNLOAD_URL"
  else
    echo "ERROR: Neither wget nor curl is available. Cannot download Maven Wrapper." >&2
    exit 1
  fi
fi

exec "$JAVACMD" -classpath "$MAVEN_WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
